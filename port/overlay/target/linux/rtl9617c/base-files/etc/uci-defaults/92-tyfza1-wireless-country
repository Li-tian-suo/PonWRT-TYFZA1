#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Defaults required by the custom firmware image:
#   - radios enabled, country CN
#   - open SSID "TYFZA1"
#   - maximum transmit power (the driver clamps to the regulatory/hardware limit)
#   - 5 GHz in HE160, 2.4 GHz in HE40
. /lib/functions.sh

[ -f /etc/config/wireless ] || exit 0

apply_radio() {
	local band
	config_get band "$1" band
	uci set "wireless.$1.country=CN"
	uci set "wireless.$1.disabled=0"
	uci set "wireless.$1.txpower=30"
	case "$band" in
		5g) uci set "wireless.$1.htmode=HE160" ;;
		2g) uci set "wireless.$1.htmode=HE40" ;;
	esac
}

apply_iface() {
	local mode
	config_get mode "$1" mode
	[ "$mode" = ap ] || return 0
	uci set "wireless.$1.ssid=TYFZA1"
	uci set "wireless.$1.encryption=none"
	uci -q delete "wireless.$1.key"
	uci set "wireless.$1.disabled=0"
}

config_load wireless
config_foreach apply_radio wifi-device
config_foreach apply_iface wifi-iface
uci commit wireless
