# Optional add-ons. They are merged into the build config like the compat list,
# but a Kconfig dependency that cannot be met on this target only produces a
# "optional package dropped" warning instead of failing the build.
# Keep the strict, mandatory selections in port/configs/tyfza1-compat.config.

# Web terminal (ttyd over HTTP).
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y

# Web file manager (LuCI JS + rpcd-mod-file, already pulled in by luci-base).
CONFIG_PACKAGE_luci-app-filemanager=y

# Large third-party applications: "m" builds them into standalone APKs without
# installing them into the 32 MiB rootfs image. They are published with the
# release and installed into the writable overlay volume by the user.
CONFIG_PACKAGE_luci-app-openclash=m
CONFIG_PACKAGE_luci-app-netspeedtest=m
CONFIG_PACKAGE_homebox=m
CONFIG_PACKAGE_ookla-speedtest=m

# lsusb is intentionally absent: usbutils depends on the virtual libudev, whose
# only provider (libudev-zero) needs libevdev, and libevdev needs the
# "input-support" config symbol which this target does not enable. Use
# /sys/bus/usb/devices or dmesg instead.

# ---------------------------------------------------------------------------
# Second tier: packages that are commonly needed by the plugins above, by
# VPN/QoS/multi-WAN setups, or to keep HomeBox / OpenClash usable offline.
# Everything here is optional: a package that Kconfig drops only produces a
# warning, and the rootfs size check decides whether the image still fits.
# ---------------------------------------------------------------------------

# VPN clients (kernel modules are already in the compat list).
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_openvpn-openssl=y

# QoS / multi-WAN / DDNS / UPnP / Wake-on-LAN.
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-wol=y

# Web shell and traffic accounting.
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_vnstat=y
CONFIG_PACKAGE_luci-app-vnstat2=y

# USB storage sharing and disk maintenance.
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_nfs-kernel-server=y
CONFIG_PACKAGE_hd-idle=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_hdparm=y
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_luci-app-p910nd=y
CONFIG_PACKAGE_kmod-usb-printer=y

# Diagnostics and helper tools.
CONFIG_PACKAGE_conntrack-tools=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_strace=y
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_zoneinfo-core=y
CONFIG_PACKAGE_zoneinfo-asia=y

# Python 3 runtime so the HomeBox / netspeedtest APK works without the
# official feed being reachable.
CONFIG_PACKAGE_python3-light=y
CONFIG_PACKAGE_python3-pkg-resources=y
CONFIG_PACKAGE_python3-xml=y
CONFIG_PACKAGE_python3-email=y
CONFIG_PACKAGE_python3-urllib=y
CONFIG_PACKAGE_python3-codecs=y
CONFIG_PACKAGE_python3-openssl=y

# USB serial adapters and extra USB Ethernet controllers.
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-ch348=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-aqc111=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-smsc95xx=y

# Additional filesystems for USB drives.
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_kmod-fs-xfs=y
CONFIG_PACKAGE_xfsprogs=y

