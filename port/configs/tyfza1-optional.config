# Optional add-ons. They are merged into the build config like the compat list,
# but a Kconfig dependency that cannot be met on this target only produces a
# "optional package dropped" warning instead of failing the build.
# Keep the strict, mandatory selections in port/configs/tyfza1-compat.config.

# Web terminal (ttyd over HTTP).
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y

# Web file manager (LuCI JS + rpcd-mod-file, already pulled in by luci-base).
CONFIG_PACKAGE_luci-app-filemanager=y

# Large third-party applications: "m" builds them into standalone APKs without
# installing them into the 32 MiB rootfs image. They are published with the
# release and installed into the writable overlay volume by the user.
CONFIG_PACKAGE_luci-app-openclash=m
CONFIG_PACKAGE_luci-app-netspeedtest=m
CONFIG_PACKAGE_homebox=m
CONFIG_PACKAGE_ookla-speedtest=m

# lsusb is intentionally absent: usbutils depends on the virtual libudev, whose
# only provider (libudev-zero) needs libevdev, and libevdev needs the
# "input-support" config symbol which this target does not enable. Use
# /sys/bus/usb/devices or dmesg instead.
