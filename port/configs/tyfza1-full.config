# TYFZA1 完整包集合配置（full profile）
# 设备：天翼 TYFZA1，SoC = Realtek RTL9617CVW
#
# 用法（二选一）：
#   A. 在 "Build TYFZA1 Full (custom packages)" 工作流里直接 Run workflow（默认就用本文件）
#   B. 在 "Build TYFZA1 firmware" 工作流的 config_file 输入里填：
#        port/configs/tyfza1-full.config
#
# 说明：
#   - 前半部分是 port/configs/tyfza1-boot.config 的内容，目标与必需组件不能删
#   - 后半部分是自定义追加包（参考另一个项目的 full 档位清单整理而来）
#   - 只存在于第三方 feed 的包（本仓库未引入该 feed）会被 make defconfig
#     静默丢弃，不会导致构建失败
#   - port/configs/tyfza1-compat.config 里的依赖会被 sync-overlay.sh 自动补回
#
# ⚠️ 重要：Kconfig 不支持行尾注释！
#   写成 CONFIG_PACKAGE_xxx=y   # 说明  会被整行忽略，
#   注释必须像下面这样独占一行。

# ============================================================
# 一、基础：目标平台与必需组件（对应 tyfza1-boot.config）
# ============================================================
CONFIG_TARGET_rtl9617c=y
CONFIG_TARGET_rtl9617c_generic=y
CONFIG_TARGET_rtl9617c_generic_DEVICE_tianyi_tyfza1=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_kmod-rtl-ax-ap=y
CONFIG_KERNEL_IKCONFIG=y
CONFIG_KERNEL_IKCONFIG_PROC=y
# CONFIG_KERNEL_KALLSYMS_EXTRA_PASS is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_UBIFS is not set
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGN_EACH_PACKAGE=y

# dnsmasq-full 取代基础 dnsmasq，二者互斥
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-app-tyfza1-pon=y
CONFIG_PACKAGE_tyfza1-pon-control=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
# CONFIG_VERSION_FILENAMES is not set
# CONFIG_VERSION_CODE_FILENAMES is not set
CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y

# ============================================================
# 二、LuCI 应用与主题
# ============================================================
CONFIG_PACKAGE_lua=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-compat=y
# luci-app-argon-config 需要 argon 仓库的 app 子目录，本仓库只装了主题，故不启用
CONFIG_PACKAGE_luci-app-adblock=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-commands=y
# 以下为第三方应用，官方 packages/luci feed 里没有，需额外引入对应 feed 才可用。
# 实测 defconfig 会静默丢弃，保留在此仅作记录，不影响构建。
# CONFIG_PACKAGE_luci-app-autoreboot is not set      # luci feed 404
# CONFIG_PACKAGE_luci-app-diskman is not set         # 第三方
# CONFIG_PACKAGE_luci-app-advanced is not set        # 第三方
# CONFIG_PACKAGE_luci-app-ddns-go is not set         # 第三方
# CONFIG_PACKAGE_luci-app-smartdns is not set        # 第三方
# CONFIG_PACKAGE_luci-app-arpbind is not set         # 第三方
CONFIG_PACKAGE_luci-app-openclash=y                 # 已加 openclash feed（e553e82, v0.48.002）
# CONFIG_PACKAGE_luci-app-udpxy is not set           # 视 luci feed 版本
# CONFIG_PACKAGE_smartdns is not set                 # 第三方

# ============================================================
# 三、USB 与 USB 网络共享
# ============================================================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_usbutils=y
# usbutils 的完整依赖链：libusb-1.0（主源码树 package/libs/libusb）、
# usbids、以及 libudev —— 后者是虚拟包，只有 libudev-zero 提供（PROVIDES:=libudev）。
# 缺任何一个，defconfig 都会把 usbutils 整体丢弃。
CONFIG_PACKAGE_libusb-1.0=y
CONFIG_PACKAGE_usbids=y
CONFIG_PACKAGE_libudev-zero=y

# ============================================================
# 四、存储 / 文件系统
# ============================================================
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
# exfatprogs 是源码包名，它产出的是 exfat-mkfs 与 exfat-fsck 两个包
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_kmod-fuse=y
# fuse3 是源码包名，它产出的是 libfuse3 与 fuse3-utils
CONFIG_PACKAGE_libfuse3=y
CONFIG_PACKAGE_fuse3-utils=y
CONFIG_PACKAGE_fuse-utils=y

# ============================================================
# 五、网络工具 / 代理 / 组播
# ============================================================
# kmod-8021q：rtl9617c 目标内核已内建 802.1Q，无独立包符号，无需（也无法）选择
# vconfig：已被 ip link 取代，上游已移除
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_igmpproxy=y
CONFIG_PACKAGE_udpxy=y
CONFIG_PACKAGE_nano=y

# ============================================================
# 六、内网测速（homebox）
# ============================================================
# 二进制已随仓库提供：port/packages/homebox/files/homebox
# （aarch64-musl 静态链接，MD5 fc84eb75e76868c2d873d55e733d12b1）
# 由 sync-overlay.sh 同步进源码树，CI 无需联网下载。
# LuCI 页面位于「服务 → Homebox」。
CONFIG_PACKAGE_homebox=y

# ============================================================
# 七、USB 文件共享（ksmbd）
# ============================================================
# 插 U 盘后通过 SMB 访问，LuCI 页面位于「网络存储 → Ksmbd」。
# 前端 luci-app-ksmbd 与后端 ksmbd-tools 都在锁定的 feeds commit 里：
#   luci    86d1549227ffef9cf60418583b7b4b9b0b06bc08
#   packages db09fc6eebf41ba0498c73e8c9c6df9088d79435
# 选 ksmbd 而不是 samba4：功能够用，体积小得多。
# 依赖的 kmod-fs-* / kmod-fuse / libfuse3 已在上面第四节选中。
CONFIG_PACKAGE_ksmbd-tools=y
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_luci-app-ksmbd=y
# 注意：这个 luci commit 里翻译目录在 applications/luci-app-ksmbd/po/ 内，
# 不单独出 luci-i18n-ksmbd-zh-cn 包，所以不要写那一行（写了会被静默丢弃）。

# ============================================================
# 八、USB 全量驱动（对齐 5585F 档位）
# ============================================================
# 以上 38 个 kmod 全部在 openwrt 主树
# package/kernel/linux/modules/{usb,fs,netfilter,nls}.mk 中确有定义，
# 已逐条核对（定义名去掉 kmod- 前缀后比对 KernelPackage/<name>）。
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-wdm=y
# USB 有线网卡
CONFIG_PACKAGE_kmod-usb-net-aqc111=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-smsc95xx=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
# USB 蜂窝/串口
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-sierrawireless=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-ch348=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y

# ============================================================
# 九、文件系统（U 盘/NAS 常用格式）
# ============================================================
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-xfs=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_ntfs-3g=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_fdisk=y

# ============================================================
# 十、网络服务与工具（对齐 5585F 档位）
# ============================================================
CONFIG_PACKAGE_nfs-kernel-server=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-mod-nat-extra=y
CONFIG_PACKAGE_kmod-ipt-raw=y
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_hdparm=y
CONFIG_PACKAGE_hd-idle=y
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_libffi=y

# ============================================================
# 十一、LuCI 应用（对齐 5585F 档位）
# ============================================================
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-vnstat2=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-proto-3g=y
# 注意：不要加 luci-proto-mbim。它的硬依赖是 umbim，而锁定 commit
# db09fc6e 的 packages feed 里没有 umbim，加进去会在镜像阶段
# "missing dependencies" 直接失败。
# 对应的驱动 kmod-usb-net-cdc-mbim 仍然保留（驱动不需要用户态组件）。

# ============================================================
# 十二、OpenClash 代理前端
# ============================================================
# openclash 不在官方 feed，已由 configs/feeds.conf 引入第三方 feed
# vernesong/OpenClash（锁定 e553e82 = v0.48.002，Lua 版，走 luci-compat）。
# 它的硬依赖此前已全部选中：dnsmasq-full/bash/curl/ca-bundle/ip-full/
# ruby/ruby-yaml/kmod-tun/unzip/kmod-inet-diag/kmod-nft-tproxy/ipset。
# luci-compat 在第一节（LuCI 基础）已选；本包在上方第三方应用区已选。

# ============================================================
# 十三、IPTV / 组播
# ============================================================
# igmpproxy 负责 IGMP 代理，udpxy 把组播流转成 HTTP 单播，
# 两者第五节已选；tcpdump 第一节已选。这里补前端与抓包库。
CONFIG_PACKAGE_luci-app-udpxy=y
CONFIG_PACKAGE_libpcap=y
# 注：不加 kmod-br-netfilter。它要求 CONFIG_BRIDGE_NETFILTER，而本内核
# config 只有 NETFILTER_FAMILY_BRIDGE=y / NF_TABLES_BRIDGE=m（nftables 路径），
# 没有 CONFIG_BRIDGE_NETFILTER。本档位用 firewall4(nftables)，
# 桥接过滤由 NF_TABLES_BRIDGE 覆盖，不需要 br_netfilter。

# ============================================================
# 十四、VLAN / 桥接
# ============================================================
# kmod-8021q 已内建（见第五节注释），无需选择。
# bridge 命令：上游已把独立的 bridge 包并入 iproute2，包名是 ip-bridge。
# ip-full 已含 bridge 子命令，补上 ip-bridge 便于老脚本直接调用。
CONFIG_PACKAGE_ip-bridge=y
# 注：不加 tc-tiny / tc-full。它们的 DEPENDS 都带 +kmod-sched-core，
# 而 kmod-sched-core 在官方 openwrt@79bc56cb 已移除（只有 immortalwrt
# 系基座才有），依赖无法解析 → defconfig 会静默丢弃整个包。
# Run #12 的实证：日志里完全没有 tc-tiny 的下载/编译记录。
# 本档位不做流量整形；需要 tc 时用 ip-full 内置的 bridge/qdisc 命令。

# ============================================================
# 十五、Mesh / 无线扩展
# ============================================================
# 802.11s mesh 由 mac80211 内建，LuCI 的 mesh 配置在
# luci-proto-relay 与本档已有的 luci 基础包里；不需要额外 kmod。
# relayd 用于中继桥接（无线中继场景）。
CONFIG_PACKAGE_relayd=y
CONFIG_PACKAGE_luci-proto-relay=y

# ============================================================
# 十六、常用网络与调试工具
# ============================================================
# ttyd / luci-app-ttyd / luci-app-commands 在第一节已选，此处不重复。
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_diffutils=y
CONFIG_PACKAGE_procps-ng=y
CONFIG_PACKAGE_pv=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_ncdu=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_openssh-sftp-server=y
