# TYFZA1 完整包集合配置（full profile）
# 设备：天翼 TYFZA1，SoC = Realtek RTL9617CVW
#
# 用法（二选一）：
#   A. 在 "Build TYFZA1 Full (custom packages)" 工作流里直接 Run workflow（默认就用本文件）
#   B. 在 "Build TYFZA1 firmware" 工作流的 config_file 输入里填：
#        port/configs/tyfza1-full.config
#
# 说明：
#   - 前半部分是 port/configs/tyfza1-boot.config 的内容，目标与必需组件不能删
#   - 后半部分是自定义追加包（参考另一个项目的 full 档位清单整理而来）
#   - 只存在于第三方 feed 的包（本仓库未引入该 feed）会被 make defconfig
#     静默丢弃，不会导致构建失败
#   - port/configs/tyfza1-compat.config 里的依赖会被 sync-overlay.sh 自动补回
#
# ⚠️ 重要：Kconfig 不支持行尾注释！
#   写成 CONFIG_PACKAGE_xxx=y   # 说明  会被整行忽略，
#   注释必须像下面这样独占一行。

# ============================================================
# 一、基础：目标平台与必需组件（对应 tyfza1-boot.config）
# ============================================================
CONFIG_TARGET_rtl9617c=y
CONFIG_TARGET_rtl9617c_generic=y
CONFIG_TARGET_rtl9617c_generic_DEVICE_tianyi_tyfza1=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_kmod-rtl-ax-ap=y
CONFIG_KERNEL_IKCONFIG=y
CONFIG_KERNEL_IKCONFIG_PROC=y
# CONFIG_KERNEL_KALLSYMS_EXTRA_PASS is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_UBIFS is not set
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGN_EACH_PACKAGE=y

# dnsmasq-full 取代基础 dnsmasq，二者互斥
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-app-tyfza1-pon=y
CONFIG_PACKAGE_tyfza1-pon-control=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
# CONFIG_VERSION_FILENAMES is not set
# CONFIG_VERSION_CODE_FILENAMES is not set
CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y

# ============================================================
# 二、LuCI 应用与主题
# ============================================================
CONFIG_PACKAGE_lua=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-compat=y
# luci-app-argon-config 需要 argon 仓库的 app 子目录，本仓库只装了主题，故不启用
CONFIG_PACKAGE_luci-app-adblock=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-commands=y
# 以下为第三方应用，官方 packages/luci feed 里没有，需额外引入对应 feed 才可用。
# 实测 defconfig 会静默丢弃，保留在此仅作记录，不影响构建。
# CONFIG_PACKAGE_luci-app-autoreboot is not set      # luci feed 404
# CONFIG_PACKAGE_luci-app-diskman is not set         # 第三方
# CONFIG_PACKAGE_luci-app-advanced is not set        # 第三方
# CONFIG_PACKAGE_luci-app-ddns-go is not set         # 第三方
# CONFIG_PACKAGE_luci-app-smartdns is not set        # 第三方
# CONFIG_PACKAGE_luci-app-arpbind is not set         # 第三方
# CONFIG_PACKAGE_luci-app-openclash is not set       # 需 openclash feed
# CONFIG_PACKAGE_luci-app-udpxy is not set           # 视 luci feed 版本
# CONFIG_PACKAGE_smartdns is not set                 # 第三方

# ============================================================
# 三、USB 与 USB 网络共享
# ============================================================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_usbutils=y
# usbutils 的完整依赖链：libusb-1.0（主源码树 package/libs/libusb）、
# usbids、以及 libudev —— 后者是虚拟包，只有 libudev-zero 提供（PROVIDES:=libudev）。
# 缺任何一个，defconfig 都会把 usbutils 整体丢弃。
CONFIG_PACKAGE_libusb-1.0=y
CONFIG_PACKAGE_usbids=y
CONFIG_PACKAGE_libudev-zero=y

# ============================================================
# 四、存储 / 文件系统
# ============================================================
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
# exfatprogs 是源码包名，它产出的是 exfat-mkfs 与 exfat-fsck 两个包
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_kmod-fuse=y
# fuse3 是源码包名，它产出的是 libfuse3 与 fuse3-utils
CONFIG_PACKAGE_libfuse3=y
CONFIG_PACKAGE_fuse3-utils=y
CONFIG_PACKAGE_fuse-utils=y

# ============================================================
# 五、网络工具 / 代理 / 组播
# ============================================================
# kmod-8021q：rtl9617c 目标内核已内建 802.1Q，无独立包符号，无需（也无法）选择
# vconfig：已被 ip link 取代，上游已移除
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_igmpproxy=y
CONFIG_PACKAGE_udpxy=y
CONFIG_PACKAGE_nano=y

# ============================================================
# 六、内网测速（homebox）
# ============================================================
# 二进制已随仓库提供：port/packages/homebox/files/homebox
# （aarch64-musl 静态链接，MD5 fc84eb75e76868c2d873d55e733d12b1）
# 由 sync-overlay.sh 同步进源码树，CI 无需联网下载。
# LuCI 页面位于「服务 → Homebox」。
CONFIG_PACKAGE_homebox=y
