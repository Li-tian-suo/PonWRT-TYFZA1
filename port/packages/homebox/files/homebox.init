#!/bin/sh /etc/rc.common

START=95
STOP=10

USE_PROCD=1

PROG=/usr/bin/homebox

start_instance() {
	local cfg="$1"
	local enabled host port workers maxconn ka

	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" = "1" ] || return 0

	config_get host "$cfg" host '0.0.0.0'
	config_get port "$cfg" port '3300'
	config_get workers "$cfg" workers ''
	config_get maxconn "$cfg" max_connections ''
	config_get ka "$cfg" keep_alive_secs ''

	procd_open_instance "$cfg"
	procd_set_param command "$PROG" serve --host "$host" --port "$port"
	[ -n "$workers" ] && procd_append_param command --workers "$workers"
	[ -n "$maxconn" ] && procd_append_param command --max-connections "$maxconn"
	[ -n "$ka" ] && procd_append_param command --keep-alive-secs "$ka"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load homebox
	config_foreach start_instance homebox
}

service_triggers() {
	procd_add_reload_trigger homebox
}

reload_service() {
	stop
	start
}
